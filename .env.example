# OrbitGuard listens on 7860 so the same command serves a Hugging Face Space.
HOST=0.0.0.0
PORT=7860

# Writable catalog and NOAA cache. Defaults to /tmp/orbitguard.
ORBITGUARD_CACHE_DIR=/tmp/orbitguard

# Optional. Space-Track is never called. If both are set, the status flag
# says only that they are configured. Values are not returned.
SPACETRACK_USER=
SPACETRACK_PASSWORD=
