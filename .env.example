# OrbitGuard AI — Configuration & Credentials

# Service Network
HOST=0.0.0.0
PORT=8045
DEBUG=false

# Database Configuration (Defaults to local SQLite async or remote Supabase/PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://postgres:your-supabase-password@db.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./orbitguard.db

# Redis Database Index Partitioning (Homelab standard: DB 3 reserved for OrbitGuard)
REDIS_URL=redis://127.0.0.1:6379/3

# Space Situational Awareness External Feeds (Optional: CelesTrak public or Space-Track account)
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# Multi-Channel Alert Dispatching (Deferred External Credentials Protocol)
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_CHAT_ID=6491601588
WEBHOOK_SECRET=orbitguard_prod_signing_secret_key

# Local Ollama / AI Copilot Inference
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b
OPENAI_API_KEY=
